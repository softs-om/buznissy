generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  password   String
  createdAt  DateTime   @default(now())
  role       UserRole   @default(OWNER)
  updatedAt  DateTime   @updatedAt
  businesses Business[]

  emailVerified Boolean   @default(false)
  image         String?
  sessions      Session[]
  accounts      Account[]
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Business {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  description          String?
  logo                 String?
  coverImage           String?
  status               BusinessStatus        @default(DRAFT)
  userId               String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  address              String?
  category             String?
  city                 String?
  country              String?
  email                String?
  instagram            String?
  phone                String?
  snapchat             String?
  tiktok               String?
  website              String?
  whatsapp             String?
  youtube              String?
  businessType         BusinessType?
  industry             String?
  customLinks          Json?
  facebook             String?
  googleMapsUrl        String?
  linkedin             String?
  x                    String?
  owner                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories           Category[]
  orders               Order[]
  products             Product[]
  services             Service[]
  publicationStatus    PublicationStatus     @default(NOT_PUBLISHED)
  subscription         Subscription?
  domains              Domain[]
  promotionRedemptions PromotionRedemption[]
  billingTransactions  BillingTransaction[]
  paymentMethods       PaymentMethod[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  businessId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products    Product[]
  services    Service[]
}

model Service {
  id                String               @id @default(cuid())
  title             String
  description       String?
  serviceType       ServiceType
  price             Float?
  categoryId        String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  advertisementType String?
  businessId        String?
  conditions        String?
  discount          Float?
  duration          Int?
  durationUnit      String               @default("minutes")
  location          String?
  sampleLink        String?
  Business          Business?            @relation(fields: [businessId], references: [id])
  category          Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  addOns            ServiceAddOn[]
  attributes        ServiceAttribute[]
  customFields      ServiceCustomField[]
  media             ServiceMedia[]
  timeSlots         ServiceTimeSlot[]
}

model ServiceAttribute {
  id          String   @id @default(cuid())
  name        String
  serviceId   String
  createdAt   DateTime @default(now())
  maxValue    Float?
  minValue    Float?
  options     String[]
  placeholder String?
  required    Boolean  @default(false)
  type        String
  updatedAt   DateTime @updatedAt
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceMedia {
  id        String   @id @default(cuid())
  url       String
  type      String
  serviceId String
  createdAt DateTime @default(now())
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceAddOn {
  id        String  @id @default(cuid())
  name      String
  price     Float   @default(0)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceTimeSlot {
  id        String    @id @default(cuid())
  startTime DateTime
  endTime   DateTime?
  available Boolean   @default(true)
  serviceId String
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceCustomField {
  id        String  @id @default(cuid())
  title     String
  value     String
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Product {
  id                String               @id @default(cuid())
  title             String
  description       String?
  basePrice         Float?
  stock             Int?
  estimatedDelivery String?
  discount          Float?
  categoryId        String?
  businessId        String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  business          Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category          Category?            @relation(fields: [categoryId], references: [id])
  customFields      ProductCustomField[]
  guides            ProductGuide[]
  media             ProductMedia[]
  variants          ProductVariant[]
}

model ProductMedia {
  id        String   @id @default(cuid())
  url       String
  type      String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id        String  @id @default(cuid())
  name      String
  value     String
  price     Float?
  stock     Int?
  image     String?
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductGuide {
  id        String  @id @default(cuid())
  title     String?
  image     String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductCustomField {
  id        String  @id @default(cuid())
  title     String
  value     String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Subscription {
  id         String             @id @default(cuid())
  businessId String             @unique
  plan       BillingPlan?
  status     SubscriptionStatus @default(NOT_STARTED)

  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  trialUsed      Boolean   @default(false)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  pausedAt           DateTime?
  remainingSeconds   Int?

  cancelAtPeriodEnd Boolean @default(false)

  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions BillingTransaction[]

  trialEligible           Boolean             @default(true)
  pausedFromStatus        SubscriptionStatus?
  nextBillingAt           DateTime?
  providerPriceId         String?
  subscriptionPlanId      String?
  subscriptionPlanPriceId String?

  subscriptionPlan      SubscriptionPlan?      @relation(fields: [subscriptionPlanId], references: [id])
  subscriptionPlanPrice SubscriptionPlanPrice? @relation(fields: [subscriptionPlanPriceId], references: [id])
}

model SubscriptionPlan {
  id              String   @id @default(cuid())
  name            String
  description     String?
  billingInterval String
  commissionRate  Decimal  @db.Decimal(5, 4)
  trialMonths     Int      @default(1)
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prices        SubscriptionPlanPrice[]
  subscriptions Subscription[]
}

model SubscriptionPlanPrice {
  id        String   @id @default(cuid())
  planId    String
  amount    Decimal  @db.Decimal(12, 3)
  currency  String   @default("OMR")
  version   Int
  createdAt DateTime @default(now())

  plan          SubscriptionPlan @relation(fields: [planId], references: [id])
  subscriptions Subscription[]

  @@unique([planId, version])
}

model PaymentMethod {
  id                      String   @id @default(cuid())
  businessId              String
  provider                String
  providerPaymentMethodId String   @unique
  brand                   String?
  last4                   String?
  expiryMonth             Int?
  expiryYear              Int?
  isDefault               Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model BillingTransaction {
  id             String                   @id @default(cuid())
  businessId     String
  subscriptionId String?
  amount         Decimal                  @db.Decimal(12, 3)
  currency       String                   @default("OMR")
  status         BillingTransactionStatus @default(PENDING)

  provider          String?
  providerPaymentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([businessId])
}

model PromotionCode {
  id   String        @id @default(cuid())
  code String        @unique
  type PromotionType

  value        Decimal? @db.Decimal(12, 3)
  durationDays Int?

  active    Boolean   @default(true)
  startsAt  DateTime?
  expiresAt DateTime?

  maxRedemptions   Int?
  perBusinessLimit Int  @default(1)

  applicablePlan BillingPlan?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions PromotionRedemption[]
}

model PromotionRedemption {
  id              String   @id @default(cuid())
  promotionCodeId String
  businessId      String
  redeemedAt      DateTime @default(now())

  promotionCode PromotionCode @relation(fields: [promotionCodeId], references: [id])
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([promotionCodeId])
}

model Order {
  id          String        @id @default(cuid())
  orderNumber String        @unique
  customer    String
  email       String?
  phone       String?
  item        String
  type        String?
  amount      Float
  notes       String?
  status      OrderStatus   @default(NEW)
  payment     PaymentStatus @default(PENDING)
  businessId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Domain {
  id         String       @id @default(cuid())
  businessId String
  hostname   String       @unique
  type       DomainType
  status     DomainStatus @default(PENDING)
  isPrimary  Boolean      @default(false)

  verifiedAt DateTime?
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

enum BillingPlan {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  NOT_STARTED
  TRIALING
  ACTIVE
  PAUSED
  PAST_DUE
  EXPIRED
  CANCELED
}

enum PublicationStatus {
  NOT_PUBLISHED
  PUBLISHED
  PAUSED
}

enum BillingTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_PERIOD
  EXTRA_TRIAL
  COMMISSION_DISCOUNT
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  FAILED
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
}

enum BusinessStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

enum UserRole {
  OWNER
  CUSTOMER
  ADMIN
}

enum BusinessType {
  TRADER
  ENTREPRENEUR
  INFLUENCER
}

enum ServiceType {
  PRODUCT
  SERVICE
  BOOKING
  PACKAGE
}
